{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git: Commit and Push Portal Repo",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "scripts/commit_and_push.sh",
        "${input:commitMessage}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message",
      "default": "Update portal engineered psychology app"
    }
  ]
}
